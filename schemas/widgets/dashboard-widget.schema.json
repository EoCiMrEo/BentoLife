{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bentolife.local/schemas/widgets/dashboard-widget.schema.json",
  "title": "BentoLife Dashboard Widget Type",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "module_id",
    "label",
    "description",
    "renderer_id",
    "default_size",
    "allowed_sizes",
    "config_schema"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$" },
    "module_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "label": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "renderer_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "default_size": { "$ref": "#/$defs/size" },
    "allowed_sizes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/size" }
    },
    "config_schema": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/configField" }
    }
  },
  "$defs": {
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 7 },
        "height": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    },
    "configField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["text", "number", "boolean", "enum", "tags", "date_range"] },
        "default": true,
        "min": { "type": "number" },
        "max": { "type": "number" },
        "options": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
